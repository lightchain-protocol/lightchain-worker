# lightchain-worker-watch@<name>.service — read-only alerting for the worker
# whose files live in /etc/lightchain/<name>/ (the worker units' layout). It
# posts Discord-compatible webhook messages when the worker's liveness
# endpoint, Redis heartbeat, Ollama, registration, suspension, stake or recent
# claims go bad, and once more on recovery. It never restarts, drains or
# sends a transaction.
#
# It runs `/usr/local/bin/lightchain-worker watch`: the one worker binary, put
# there by the installer (docs/install.md, step 1), from a release that has the
# `watch` command. A worker-only binary (cmd/sidecar: /bin/worker in the Docker
# image) ignores its arguments, so at that path it would run as a second
# worker; ExecCondition below refuses to start the unit on such a binary. On a
# host whose binary lives elsewhere, override ExecCondition and ExecStart
# together in a drop-in.
#
# Install, as root, for worker <name> (`worker` on a host set up by docs/install.md):
#   install -m 644 lightchain-worker-watch@.service /etc/systemd/system/
#   ( umask 077; echo 'WATCH_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>' \
#       > /etc/lightchain/<name>/watch.env )
#   # Units that set chain settings with Environment= lines instead of the env
#   # file: append those lines too, so watch reads what the worker reads (re-run
#   # after changing the worker unit). The env file still wins, as for the worker.
#   systemctl show -p Environment --value lightchain-<name> | tr ' ' '\n' \
#     >> /etc/lightchain/<name>/watch.env
#   # Any further EnvironmentFile= of the worker unit (e.g. a Redis password):
#   systemctl show -p EnvironmentFiles --value lightchain-<name>
#   # add each one as EnvironmentFile=<path> in: systemctl edit lightchain-worker-watch@<name>
#   # Run as the worker's user: `systemctl show -p User --value lightchain-<name>`
#   # (empty = root). For any other user: systemctl edit lightchain-worker-watch@<name>
#   # and set User= there; that user must be able to read both env files.
#   systemctl daemon-reload
#   systemctl enable --now lightchain-worker-watch@<name>
#   journalctl -u lightchain-worker-watch@<name> -f     # expect "watch started"
#
# Optional in watch.env: WATCH_INTERVAL (30s), WATCH_COOLDOWN (1h, minimum gap
# between repeat alerts for a check that stays failing), WATCH_MISSED_CLAIMS (3:
# sessions in a row lost to other workers while eligible; 0 disables),
# WATCH_WORKER_ADDRESS (the worker's address. Default: the address field of the
# keystore at WORKER_KEYSTORE_PATH, read without the password; set the variable
# when watch exits with "keystore … has no address field").
#
# Docker workers (external-worker guide): run the same image beside the worker,
# in its network namespace so 127.0.0.1:9101/healthz is the worker's:
#   docker run -d --name lightchain-worker-watch --restart unless-stopped \
#     --network container:lightchain-worker --env-file ~/lightchain-worker/worker.env \
#     -e WATCH_WEBHOOK_URL=... -v ~/lightchain-worker/keys:/keys:ro \
#     --entrypoint /bin/lightchain-worker <worker image> watch

[Unit]
Description=LightChain worker watch (%i) - webhook alerts, read-only
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# watch.env first: like Environment= in the worker unit, the env file overrides it.
EnvironmentFile=/etc/lightchain/%i/watch.env
EnvironmentFile=/etc/lightchain/%i/env
# Start only if the binary lists the `watch` command. env -i: with an empty
# environment a worker-only binary exits on its missing config, so the check
# itself can never start a worker.
ExecCondition=/bin/sh -c 'env -i /usr/local/bin/lightchain-worker help 2>&1 | grep -q "^  watch "'
ExecStart=/usr/local/bin/lightchain-worker watch
Restart=always
RestartSec=10
# watch only reads; the sandbox makes the filesystem read-only for it too.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
